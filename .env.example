# Convex (dev project — set production/preview URLs in Vercel)
NEXT_PUBLIC_CONVEX_URL=https://brilliant-iguana-748.convex.cloud

# Convex Auth (generate with: openssl rand -base64 32)
AUTH_SECRET_0=
AUTH_SECRET_1=
AUTH_SECRET_2=
AUTH_SECRET_3=

# Mapbox (server-side only — proxied via /api/mapbox/token)
MAPBOX_TOKEN=

# M-Pesa Daraja (get from Safaricom developer portal)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=174379
DARAJA_ENV=sandbox

# App (must be production URL on Vercel, e.g. https://cruiselinx.vercel.app)
NEXT_PUBLIC_URL=http://localhost:3000

# Convex deployment reference (set by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:brilliant-iguana-748

# Convex site URL for file uploads
NEXT_PUBLIC_CONVEX_SITE_URL=https://brilliant-iguana-748.convex.site

# Shared secret for M-Pesa callback authentication
MPESA_CALLBACK_SECRET=

# VAPID Keys for Push Notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=